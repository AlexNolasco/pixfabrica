# Copy to api/.env (gitignored). Used by pnpm dev:all and run-all.sh.
#
# Manual API only (bash, from repo root):
#   set -a && source api/.env && set +a
#   uv run uvicorn pixfabrica_api.main:app --reload --port 8000
#
# Without these vars the API uses hosted defaults: 600s, 1920×1080, 30fps.
# That hides most vertical platform presets (e.g. 1080×1920 fails on height).

# Local dev — match docker/compose.yml relaxed limits (core ceiling)
PIXFABRICA_MAX_DURATION_S=3600
PIXFABRICA_MAX_WIDTH=3840
PIXFABRICA_MAX_HEIGHT=2160
PIXFABRICA_MAX_FPS=60

# Must match VITE_API_TOKEN in web/.env.local when set
# API_TOKEN=pixfabrica-dev-token

# Optional compose agent (see api/README.md)
# PIXFABRICA_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional deployment default locale (en, es, zh-CN, ja)
# PIXFABRICA_DEFAULT_LOCALE=ja

# Optional stock photos — View → Stock Photos… (server-side only; get key at pexels.com/api)
# PIXFABRICA_PEXELS_API_KEY=
# PIXFABRICA_PEXELS_DEFAULT_QUERIES=inspirational,music
# PIXFABRICA_PEXELS_DEFAULT_VIDEO_QUERIES=cinematic,abstract,motion
