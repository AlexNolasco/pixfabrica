# Copy to docker/.env and pass with: docker compose --env-file docker/.env …

# Shared secret — web image bakes this at build time; change requires: docker compose build web
API_TOKEN=pixfabrica-dev-token

# Host folder for uploads, renders, cache, and user fonts
PIXFABRICA_DATA_DIR=./pixfabrica-data

# Browser URL port (nginx)
HOST_PORT=8080

# AMD GPU overlay only — host render group GID (getent group render | cut -d: -f3)
# GPU_RENDER_GID=

# Compose agent (optional — enable with: docker compose --profile compose …)
# PIXFABRICA_OLLAMA_BASE_URL=http://ollama:11434

# Exclude NC-licensed catalog nodes on this host (empty = show all).
# PIXFABRICA_CATALOG_EXCLUDED_LICENSES=CC-BY-NC-SA-3.0,CC-BY-NC-SA-4.0

# Deployment default UI/API locale on first visit (en, es, zh-CN, ja). Unset = en.
# PIXFABRICA_DEFAULT_LOCALE=ja
